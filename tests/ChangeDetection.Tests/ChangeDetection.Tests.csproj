<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fizzler.Systems.HtmlAgilityPack" Version="1.2.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.9.0" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="TUnit" Version="1.65.68" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="EndToEnd\Resources\*.html" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Pipeline\Golden\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Pipeline\Blocks\Integration\Fixtures\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ChangeDetection.Core\ChangeDetection.Core.csproj" />
    <ProjectReference Include="..\..\src\ChangeDetection.Shared\ChangeDetection.Shared.csproj" />
    <ProjectReference Include="..\..\src\ChangeDetection\ChangeDetection\ChangeDetection.csproj" />
    <ProjectReference Include="..\..\src\ChangeDetection\ChangeDetection.Client\ChangeDetection.Client.csproj" Condition="'$(SkipClientProjectReference)' != 'true'" />
  </ItemGroup>

</Project>
